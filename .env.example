# Postgres connection (local dev: Homebrew/Postgres.app; production: Neon)
DATABASE_URL=postgres://USER@localhost:5432/context_dev

# AI provider for chapter studies, Ask, and Text or Assumption? (gemini has a free tier)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Optional alternative: AI_PROVIDER=claude with ANTHROPIC_API_KEY=

# 1 = show the Verify button on claims (local curation only; never set in production)
CONTEXT_CURATOR=

# Public-site protection for the free AI quota (per rolling 24h)
# AI_DAILY_LIMIT_PER_USER=40
# AI_DAILY_LIMIT_SITE=300

# Licensed translations (NIV, NLT, NASB) via API.Bible — non-commercial Starter plan. Display only; never sent to AI.
# API_BIBLE_KEY=

# Sign in with Google (Auth.js)
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
