{
  "name": "context",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import.ts",
    "db:reset": "dropdb --if-exists context_dev && createdb context_dev && npm run db:migrate && npm run db:import",
    "data:fetch": "bash scripts/fetch-data.sh",
    "study:generate": "tsx --conditions=react-server scripts/generate.ts",
    "study:smoke": "tsx --conditions=react-server scripts/smoke-study.ts",
    "study:books": "tsx --conditions=react-server scripts/generate-books.ts",
    "data:commentaries": "tsx scripts/fetch-commentaries.ts",
    "data:amharic": "tsx scripts/fetch-wordproject-amh.ts",
    "data:reference": "tsx scripts/fetch-reference-works.ts",
    "db:commentaries": "tsx scripts/import-commentaries.ts",
    "db:translations": "tsx scripts/import-translations.ts",
    "db:amharic": "tsx scripts/import-amharic-restore.ts",
    "db:reference": "tsx scripts/import-reference-works.ts",
    "cache:warm": "tsx scripts/warm-cache.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
